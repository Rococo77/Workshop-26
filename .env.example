# ============================================================================
#  PROJECT RESILIENCE-ALPHA — Variables d'environnement (MODÈLE)
# ----------------------------------------------------------------------------
#  Copier en `.env` puis renseigner. NE JAMAIS committer `.env`.
#  Source de vérité : HashiCorp Vault (scripts/vault.sh import / render).
#  Ici, modèle non sensible pour le démonstrateur.
# ============================================================================

# --- Identification du groupe ------------------------------------------------
# Affiché dans le frontend (import.meta.env.VITE_NUM_GROUPE) et utilisé pour
# nommer le hotspot de démo (RESILIENCE-G<n>, voir ESP_WIFI_SSID plus bas).
NUM_GROUPE=1

# --- Base de données métier -------------------------------------------------
POSTGRES_USER=payuser
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=paymentdb
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Service d'authentification (JWT) ---------------------------------------
# Générer : openssl rand -hex 32
JWT_SECRET=change_me_run_openssl_rand_hex_32_to_get_64_hex_chars_minimum_0000
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
# Durée de vie du jeton intermédiaire (mot de passe validé, visage à
# vérifier) émis par /auth/login pour un client, consommé par
# POST /api/auth/login/face (payment-api).
FACE_PENDING_EXPIRE_SECONDS=120

# --- Remédiation (automate) -------------------------------------------------
# Jeton d'appel interne détecteur -> moteur de remédiation (allowlist)
REMEDIATION_API_TOKEN=change_me_internal_token

# --- Validation faciale des virements (DeepFace) -----------------------------
# Jeton interne payment-api -> face-api. Générer : openssl rand -hex 32
FACE_API_TOKEN=change_me_face_api_token
# false = virements réglés immédiatement (comportement historique)
FACE_CONFIRMATION_REQUIRED=true
# Distance cosinus max (Facenet512). Plus bas = plus strict (plus de faux refus).
FACE_MATCH_THRESHOLD=0.30
# Détection de photo d'écran / imprimée (FasNet)
FACE_ANTI_SPOOFING=true

# --- Auto-inscription (mot de passe + visage) --------------------------------
# Solde initial (fictif) d'un compte créé via POST /api/auth/register.
REGISTRATION_STARTING_BALANCE=1000.00

# --- Indicateur LED ESP8266 (démo bonus, firmware/face-led/) ----------------
# Jeton du relais WebSocket /api/ws/face-events (voir firmware/face-led/README.md).
ESP_EVENTS_TOKEN=change_me_esp_events_token
# Flash de la carte (scripts/flash-esp.sh génère firmware/face-led/include/secrets.h).
# Réseau Wi-Fi 2,4 GHz rejoint par l'ESP8266 (le même que le PC Hôte).
ESP_WIFI_SSID=
ESP_WIFI_PASSWORD=
# Optionnels : IP du PC Hôte (défaut : détectée) et port série (défaut : CH340 détecté).
ESP_WS_HOST=
ESP_SERIAL_PORT=

# --- Détection ML -----------------------------------------------------------
PROMETHEUS_URL=http://prometheus:9090
DETECTION_INTERVAL_SECONDS=10
ANOMALY_CONTAMINATION=0.05

# --- Assistant RAG (Ollama) -------------------------------------------------
OLLAMA_BASE_URL=http://ollama:11434
# Qwen3 (GGUF Unsloth). 4B par défaut (CPU, ~2,5 Go) ; 8B si la machine suit :
#   OLLAMA_MODEL=hf.co/unsloth/Qwen3-8B-GGUF:Q4_K_M
OLLAMA_MODEL=hf.co/unsloth/Qwen3-4B-GGUF:Q4_K_M
RAG_EMBED_MODEL=nomic-embed-text

# --- Grafana ----------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_grafana

# --- Exposition réseau (point d'entrée) -------------------------------------
# EDGE_BIND  : interface sur laquelle publier le WAF (seul service exposé au
#              réseau du groupe).
#   - 0.0.0.0        : dev/CI (toutes interfaces).
#   - 192.168.137.1  : DÉMO — n'expose QUE le réseau du groupe (hotspot RESILIENCE-G<n>).
# EDGE_PORT  : port hôte du WAF (défaut 8080). Changer si 8080 est déjà pris
#              (ex. Oracle TNS/APEX) sans vouloir arrêter ce service.
# GRAFANA_PORT : port hôte de Grafana (défaut 3000). Grafana est TOUJOURS bindé
#              sur 127.0.0.1 (login propre = cible de force brute), jamais sur EDGE_BIND.
EDGE_BIND=0.0.0.0
EDGE_PORT=8080
GRAFANA_PORT=3000
