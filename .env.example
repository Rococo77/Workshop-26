# ============================================================================
#  PROJECT RESILIENCE-ALPHA — Variables d'environnement (MODÈLE)
# ----------------------------------------------------------------------------
#  Copier en `.env` puis renseigner. NE JAMAIS committer `.env`.
#  En production, ces valeurs sont servies par SOPS/age (voir scripts/secrets.sh)
#  ou HashiCorp Vault. Ici, modèle non sensible pour le démonstrateur.
# ============================================================================

# --- Base de données métier -------------------------------------------------
POSTGRES_USER=payuser
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=paymentdb
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Service d'authentification (JWT) ---------------------------------------
# Générer : openssl rand -hex 32
JWT_SECRET=change_me_run_openssl_rand_hex_32_to_get_64_hex_chars_minimum_0000
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# --- Remédiation (automate) -------------------------------------------------
# Jeton d'appel interne détecteur -> moteur de remédiation (allowlist)
REMEDIATION_API_TOKEN=change_me_internal_token

# --- Détection ML -----------------------------------------------------------
PROMETHEUS_URL=http://prometheus:9090
DETECTION_INTERVAL_SECONDS=10
ANOMALY_CONTAMINATION=0.05

# --- Assistant RAG (Ollama) -------------------------------------------------
OLLAMA_BASE_URL=http://ollama:11434
# Qwen3 (GGUF Unsloth). 4B par défaut (CPU, ~2,5 Go) ; 8B si la machine suit :
#   OLLAMA_MODEL=hf.co/unsloth/Qwen3-8B-GGUF:Q4_K_M
OLLAMA_MODEL=hf.co/unsloth/Qwen3-4B-GGUF:Q4_K_M
RAG_EMBED_MODEL=nomic-embed-text

# --- Grafana ----------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_grafana
