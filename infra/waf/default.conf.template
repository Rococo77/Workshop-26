# ============================================================================
#  WAF — reverse proxy durci (ModSecurity + CRS actifs au niveau http via
#  la configuration de l'image). Contexte http : zone de limitation par IP.
# ============================================================================
limit_req_zone $binary_remote_addr zone=perip:10m rate=50r/s;
# Reconnaissance faciale : calcul coûteux + cible de force brute -> plus strict.
limit_req_zone $binary_remote_addr zone=face:10m rate=2r/s;
limit_req_status 429;

# Résolution DNS à chaque requête : un service recréé change d'IP. Avec un nom
# fixe dans proxy_pass, nginx le résolvait une seule fois au démarrage et
# renvoyait ensuite 502, ou 404 si l'ancienne IP avait été réattribuée à un
# autre conteneur. Le `resolver` (DNS Docker 127.0.0.11) est déjà déclaré par
# l'image CRS (nginx.conf, RESOLVERS) : ne pas le redéclarer (doublon = emerg).

server {
    listen 8080;
    server_name _;

    # Journaux d'accès : stdout -> Promtail -> Loki (SIEM, extraction IP source)
    # ET fichier -> exporter de logs -> Prometheus (métriques par statut, signal
    # de détection fiable et temps réel).
    access_log /dev/stdout;
    access_log /var/log/ra/ra_access.log combined;
    error_log /dev/stderr warn;

    # ModSecurity + OWASP CRS sont activés GLOBALEMENT par l'image CRS
    # (conf.d/modsecurity.conf -> setup.conf), donc actifs ici sans redéclaration.

    # Blocklist dynamique : le moteur de remédiation écrit ici des
    # `if ($remote_addr = "<ip>") { return 444; }` puis `nginx -s reload`.
    # 444 (et non le 403 de `deny`) : évaluée avant limit_req/CRS, et distincte
    # des 403 du CRS pour ne pas fausser la qualification injection vs DoS.
    # Le glob tolère l'absence de fichier.
    include /etc/nginx/dynamic/*.conf;

    # En-têtes de durcissement.
    server_tokens off;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;

    # Taille de corps bornée (anti-abus).
    client_max_body_size 256k;

    # Upstreams en variables : seule façon de forcer la résolution via
    # `resolver`. Contrepartie : proxy_pass ne retire plus le préfixe de
    # location, d'où les `rewrite ... break` ci-dessous.
    set $up_auth ${BACKEND_AUTH};
    set $up_api ${BACKEND_API};
    set $up_bff ${BACKEND_BFF};
    set $up_front ${BACKEND_FRONTEND};

    location /auth/ {
        limit_req zone=perip burst=20 nodelay;
        rewrite ^/auth/(.*)$ /$1 break;
        proxy_pass http://$up_auth;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 10s;
    }

    location /api/ {
        limit_req zone=perip burst=20 nodelay;
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass http://$up_api;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 10s;
    }

    # Enrôlement, confirmation, auto-inscription et second facteur faciaux :
    # photo en base64 brut dans le JSON (bornée par la limite ModSecurity des
    # corps sans fichier, 128 Ko), inférence DeepFace -> délai plus long et
    # cible de force brute -> zone stricte. Regex : prioritaire sur /api/.
    location ~ ^/api/(face/enrollment|transactions/[0-9]+/confirm|auth/register|auth/login/face)$ {
        limit_req zone=face burst=5 nodelay;
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass http://$up_api;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 40s;
    }

    # L'endpoint interne /internal ne doit JAMAIS être exposé via le WAF.
    location /api/internal/ { return 404; }

    # Page /supervision (React) vs API /supervision/... (BFF). Correspondances
    # exactes : sans elles, nginx redirigerait /supervision vers l'API.
    location = /supervision {
        proxy_pass http://$up_front;
        proxy_set_header Host $host;
    }
    location = /supervision/ {
        absolute_redirect off;
        return 302 /supervision;
    }

    # Supervision (lecture seule) pour le dashboard React.
    location /supervision/ {
        limit_req zone=perip burst=30 nodelay;
        rewrite ^/supervision/(.*)$ /$1 break;
        proxy_pass http://$up_bff;
        proxy_set_header Host $host;
        proxy_read_timeout 10s;
    }

    location / {
        proxy_pass http://$up_front;
        proxy_set_header Host $host;
    }

    location /waf-health { default_type text/plain; return 200 "waf-ok\n"; }
}
