# ============================================================================
#  WAF — reverse proxy durci (ModSecurity + CRS actifs au niveau http via
#  la configuration de l'image). Contexte http : zone de limitation par IP.
# ============================================================================
limit_req_zone $binary_remote_addr zone=perip:10m rate=50r/s;
limit_req_status 429;

server {
    listen 8080;
    server_name _;

    # Journaux d'accès : stdout -> Promtail -> Loki (SIEM, extraction IP source)
    # ET fichier -> exporter de logs -> Prometheus (métriques par statut, signal
    # de détection fiable et temps réel).
    access_log /dev/stdout;
    access_log /var/log/ra/ra_access.log combined;
    error_log /dev/stderr warn;

    # ModSecurity + OWASP CRS sont activés GLOBALEMENT par l'image CRS
    # (conf.d/modsecurity.conf -> setup.conf), donc actifs ici sans redéclaration.

    # Blocklist dynamique : le moteur de remédiation écrit ici des
    # `if ($remote_addr = "<ip>") { return 444; }` puis `nginx -s reload`.
    # 444 (et non le 403 de `deny`) : évaluée avant limit_req/CRS, et distincte
    # des 403 du CRS pour ne pas fausser la qualification injection vs DoS.
    # Le glob tolère l'absence de fichier.
    include /etc/nginx/dynamic/*.conf;

    # En-têtes de durcissement.
    server_tokens off;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;

    # Taille de corps bornée (anti-abus).
    client_max_body_size 256k;

    location /auth/ {
        limit_req zone=perip burst=20 nodelay;
        proxy_pass http://${BACKEND_AUTH}/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 10s;
    }

    location /api/ {
        limit_req zone=perip burst=20 nodelay;
        proxy_pass http://${BACKEND_API}/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 10s;
    }

    # L'endpoint interne /internal ne doit JAMAIS être exposé via le WAF.
    location /api/internal/ { return 404; }

    # Page /supervision (React) vs API /supervision/... (BFF). Correspondances
    # exactes : sans elles, nginx redirigerait /supervision vers l'API.
    location = /supervision {
        proxy_pass http://${BACKEND_FRONTEND};
        proxy_set_header Host $host;
    }
    location = /supervision/ {
        absolute_redirect off;
        return 302 /supervision;
    }

    # Supervision (lecture seule) pour le dashboard React.
    location /supervision/ {
        limit_req zone=perip burst=30 nodelay;
        proxy_pass http://${BACKEND_BFF}/;
        proxy_set_header Host $host;
        proxy_read_timeout 10s;
    }

    location / {
        proxy_pass http://${BACKEND_FRONTEND}/;
        proxy_set_header Host $host;
    }

    location /waf-health { default_type text/plain; return 200 "waf-ok\n"; }
}
