          "expr": "{service=\"waf\"} |= `\"transaction\"` | json ip=\"transaction.client_ip\", method=\"transaction.request.method\", uri=\"transaction.request.uri\", code=\"transaction.response.http_code\", rule=\"transaction.messages[0].message\" | rule !~ \"Host header is a numeric IP.*\" | code >= 400 or rule != \"\" | label_format level=`{{ if ge (int .code) 400 }}warning{{ else }}info{{ end }}` | line_format `{{ .code }}  {{ .ip }}  {{ .method }} {{ .uri }}{{ if .rule }}  [{{ .rule }}]{{ end }}`",
