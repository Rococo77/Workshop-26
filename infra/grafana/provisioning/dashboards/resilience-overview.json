          },
          "expr": "{service=~\"ml-detector|remediation\"} |~ `^\\d{4}-` != \"httpx\" | regexp `^\\d{4}-\\d\\d-\\d\\d [\\d:,]+ (?P<level>[A-Z]+) (?P<logger>\\S+) (?P<msg>.*)$` | line_format `{{ printf \"%-12s\" .service }} {{ .msg }}`",
