<mxCell id="site" value="&lt;b&gt;Site web&lt;/b&gt;&lt;br&gt;espace client" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=13;fillColor=#ffffff;strokeColor=#90caf9;fontColor=#333333;" vertex="1" parent="platform"><mxGeometry x="20" y="50" width="160" height="95" as="geometry"/></mxCell>
<mxCell id="payments" value="&lt;b&gt;Paiements&lt;/b&gt;&lt;br&gt;virements sécurisés" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=13;fillColor=#ffffff;strokeColor=#90caf9;fontColor=#333333;" vertex="1" parent="platform"><mxGeometry x="195" y="50" width="160" height="95" as="geometry"/></mxCell>
<mxCell id="login" value="&lt;b&gt;Connexion&lt;/b&gt;&lt;br&gt;mot de passe + visage" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=13;fillColor=#ffffff;strokeColor=#90caf9;fontColor=#333333;" vertex="1" parent="platform"><mxGeometry x="370" y="50" width="160" height="95" as="geometry"/></mxCell>
<mxCell id="data" value="&lt;b&gt;Données clients&lt;/b&gt;&lt;br&gt;isolées, jamais exposées&lt;br&gt;comptes pièges anti-fuite" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fontSize=13;fillColor=#e8f5e9;strokeColor=#81c784;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1110" y="80" width="150" height="130" as="geometry"/></mxCell>
<mxCell id="loop" value="Boucle de résilience automatique, sans intervention humaine" style="swimlane;startSize=28;html=1;rounded=1;fontSize=14;fontStyle=1;fillColor=#ede7f6;strokeColor=#b39ddb;fontColor=#333333;swimlaneFillColor=#faf8fe;" vertex="1" parent="1"><mxGeometry x="260" y="300" width="830" height="180" as="geometry"/></mxCell>
<mxCell id="s1" value="&lt;b&gt;1. Surveiller&lt;/b&gt;&lt;br&gt;activité et journaux&lt;br&gt;en continu" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=13;fillColor=#ffffff;strokeColor=#b39ddb;fontColor=#333333;" vertex="1" parent="loop"><mxGeometry x="20" y="50" width="180" height="100" as="geometry"/></mxCell>
<mxCell id="s2" value="&lt;b&gt;2. Détecter&lt;/b&gt;&lt;br&gt;une IA repère&lt;br&gt;le comportement anormal" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=13;fillColor=#ffffff;strokeColor=#b39ddb;fontColor=#333333;" vertex="1" parent="loop"><mxGeometry x="230" y="50" width="180" height="100" as="geometry"/></mxCell>
<mxCell id="s3" value="&lt;b&gt;3. Réagir&lt;/b&gt;&lt;br&gt;bloque l'attaquant, relance&lt;br&gt;le service, met les&lt;br&gt;virements en attente" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=13;fillColor=#ffffff;strokeColor=#b39ddb;fontColor=#333333;" vertex="1" parent="loop"><mxGeometry x="440" y="50" width="180" height="100" as="geometry"/></mxCell>
<mxCell id="s4" value="&lt;b&gt;4. Vérifier&lt;/b&gt;&lt;br&gt;un paiement test confirme&lt;br&gt;que tout fonctionne" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=13;fillColor=#ffffff;strokeColor=#b39ddb;fontColor=#333333;" vertex="1" parent="loop"><mxGeometry x="630" y="50" width="180" height="100" as="geometry"/></mxCell>
<mxCell id="dash" value="&lt;b&gt;Tableau de bord&lt;/b&gt;&lt;br&gt;état du service, alertes, actions&lt;br&gt;et rapport d'incident automatique" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f5f5f5;strokeColor=#bdbdbd;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="380" y="550" width="260" height="80" as="geometry"/></mxCell>
