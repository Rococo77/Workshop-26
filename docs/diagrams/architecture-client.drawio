<mxCell id="title" value="&lt;b&gt;Plateforme de paiement Alpha&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Comment elle se protège et se rétablit toute seule&lt;/font&gt;" style="text;html=1;fontSize=20;align=left;verticalAlign=middle;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="800" height="50" as="geometry"/></mxCell>
