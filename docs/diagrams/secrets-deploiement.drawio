<diagram id="p0" name="Vault">
<mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1500" pageHeight="760">
<root>
<mxCell id="0"/>
<mxCell id="1" parent="0"/>
<mxCell id="t1" value="&lt;b&gt;Gestion des secrets : HashiCorp Vault source de vérité&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1420" height="30" as="geometry"/></mxCell>
<mxCell id="t2" value="Le .env n&#x27;est qu&#x27;un rendu produit au déploiement ; les services ne lisent jamais Vault au démarrage." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1420" height="24" as="geometry"/></mxCell>
<mxCell id="env0" value="&lt;b&gt;.env initial&lt;/b&gt;&lt;br&gt;(saisie locale, ignoré par git)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="230" height="80" as="geometry"/></mxCell>
<mxCell id="z3" value="secrets (réseau dédié, aucun autre service)" style="swimlane;startSize=24;html=1;rounded=1;fillColor=#eeeeee;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="400" y="120" width="460" height="330" as="geometry"/></mxCell>
<mxCell id="vault" value="&lt;b&gt;Vault 2.1.2&lt;/b&gt; · 127.0.0.1:8201&lt;br&gt;KV v2 secret/resilience-alpha&lt;br&gt;stockage fichier (volume vault-data)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="430" y="170" width="400" height="90" as="geometry"/></mxCell>
<mxCell id="c4" value="&lt;b&gt;Politique deploy&lt;/b&gt;&lt;br&gt;lecture seule&lt;br&gt;d&#x27;un seul chemin&lt;br&gt;(écriture : 403)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="430" y="310" width="190" height="110" as="geometry"/></mxCell>
<mxCell id="aud" value="&lt;b&gt;Audit&lt;/b&gt;&lt;br&gt;chaque accès&lt;br&gt;sur stdout" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="640" y="310" width="190" height="110" as="geometry"/></mxCell>
<mxCell id="env1" value="&lt;b&gt;.env rendu&lt;/b&gt;&lt;br&gt;lu par Docker Compose" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="980" y="150" width="260" height="80" as="geometry"/></mxCell>
<mxCell id="loki" value="&lt;b&gt;Promtail → Loki&lt;/b&gt;&lt;br&gt;(SIEM, Grafana)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="980" y="325" width="260" height="80" as="geometry"/></mxCell>
<mxCell id="keys" value="&lt;b&gt;.vault/&lt;/b&gt; (local, ignoré)&lt;br&gt;clé de descellement&lt;br&gt;jeton racine&lt;br&gt;jeton deploy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="60" y="310" width="230" height="110" as="geometry"/></mxCell>
<mxCell id="ans" value="&lt;b&gt;Ansible deploy.yml&lt;/b&gt;&lt;br&gt;à chaque déploiement" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="980" y="470" width="260" height="80" as="geometry"/></mxCell>
<mxCell id="e5" value="vault.sh import (jeton racine)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;fontSize=11;strokeColor=#333333;fontColor=#333333;strokeWidth=1;entryX=0;entryY=0.22;entryDx=0;entryDy=0;" edge="1" source="env0" target="vault" parent="1"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e6" value="vault.sh render (jeton deploy)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;fontSize=11;strokeColor=#82b366;fontColor=#82b366;strokeWidth=2;exitX=1;exitY=0.22;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="vault" target="env1" parent="1"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e7" value="journal d&#x27;audit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;fontSize=11;strokeColor=#82b366;fontColor=#82b366;strokeWidth=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="aud" target="loki" parent="1"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e8" value="vault.sh unseal" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;fontSize=11;strokeColor=#333333;fontColor=#333333;strokeWidth=1;dashed=1;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.85;entryDx=0;entryDy=0;" edge="1" source="keys" target="vault" parent="1"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="350" y="343"/><mxPoint x="350" y="246"/></Array></mxGeometry></mxCell>
<mxCell id="e9" value="unseal puis render" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;fontSize=11;strokeColor=#d79b00;fontColor=#d79b00;strokeWidth=1;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.85;entryDx=0;entryDy=0;" edge="1" source="ans" target="vault" parent="1"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="900" y="510"/><mxPoint x="900" y="246"/></Array></mxGeometry></mxCell>
<mxCell id="t10" value="&lt;b&gt;Pourquoi un rendu et pas une lecture au démarrage ?&lt;/b&gt; Le moteur de remédiation relance auth et payment-api pendant un incident. Si ces services dépendaient de Vault, un Vault scellé (il redémarre toujours scellé) bloquerait la reprise autonome. Vault reste donc hors du chemin critique de la reprise.&lt;br&gt;&lt;b&gt;Cible production&lt;/b&gt; : Shamir 5/3 ou auto-unseal KMS/HSM, cluster Raft + TLS, secrets dynamiques PostgreSQL via AppRole et Vault Agent." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="600" width="1380" height="120" as="geometry"/></mxCell>
</root>
</mxGraphModel>
</diagram>
<diagram id="p1" name="Ansible">
<mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1500" pageHeight="700">
<root>
<mxCell id="0"/>
<mxCell id="1" parent="0"/>
<mxCell id="t1" value="&lt;b&gt;Exploitation Day-0/1 avec Ansible (infra/ansible/)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1420" height="30" as="geometry"/></mxCell>
<mxCell id="t2" value="Distinct de la reprise Day-2 : Ansible n&#x27;est jamais dans la boucle de remédiation live." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1420" height="24" as="geometry"/></mxCell>
<mxCell id="z3" value="site.yml : chaîne nominale" style="swimlane;startSize=24;html=1;rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="1000" height="200" as="geometry"/></mxCell>
<mxCell id="a1" value="&lt;b&gt;1. preflight.yml&lt;/b&gt;&lt;br&gt;Docker, Compose v2,&lt;br&gt;community.docker,&lt;br&gt;Vault ou .env présent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="90" y="170" width="280" height="120" as="geometry"/></mxCell>
<mxCell id="a2" value="&lt;b&gt;2. deploy.yml&lt;/b&gt;&lt;br&gt;unseal + render Vault&lt;br&gt;compose up (build)&lt;br&gt;attente /api/ready" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="410" y="170" width="280" height="120" as="geometry"/></mxCell>
<mxCell id="a3" value="&lt;b&gt;3. harden.yml&lt;/b&gt;&lt;br&gt;no-new-privileges, cap_drop,&lt;br&gt;read_only, proxy Docker,&lt;br&gt;.env non suivi, exposition" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="730" y="170" width="300" height="120" as="geometry"/></mxCell>
<mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;fontSize=11;strokeColor=#d79b00;fontColor=#d79b00;strokeWidth=2;" edge="1" source="a1" target="a2" parent="1"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;fontSize=11;strokeColor=#d79b00;fontColor=#d79b00;strokeWidth=2;" edge="1" source="a2" target="a3" parent="1"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="z6" value="Playbooks autonomes" style="swimlane;startSize=24;html=1;rounded=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="380" width="1000" height="180" as="geometry"/></mxCell>
<mxCell id="c7" value="&lt;b&gt;ops.yml&lt;/b&gt;&lt;br&gt;action=status · restart_api ·&lt;br&gt;backup_db" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="90" y="430" width="280" height="100" as="geometry"/></mxCell>
<mxCell id="b" value="&lt;b&gt;backup.yml&lt;/b&gt;&lt;br&gt;pg_dump horodaté&lt;br&gt;rétention 7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="410" y="430" width="280" height="100" as="geometry"/></mxCell>
<mxCell id="r" value="&lt;b&gt;restore.yml&lt;/b&gt; -e confirm=yes&lt;br&gt;restaure puis &lt;b&gt;prouve&lt;/b&gt;&lt;br&gt;(/api/ready doit repasser à 200)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="730" y="430" width="300" height="100" as="geometry"/></mxCell>
<mxCell id="e8" value="PRA" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;fontSize=11;strokeColor=#82b366;fontColor=#82b366;strokeWidth=1;" edge="1" source="b" target="r" parent="1"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c9" value="&lt;b&gt;Windows + Docker Desktop&lt;/b&gt;&lt;br&gt;compose up côté PowerShell,&lt;br&gt;puis site.yml&lt;br&gt;-e deploy_via_ansible=false" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;dashed=1;" vertex="1" parent="1"><mxGeometry x="1120" y="170" width="320" height="120" as="geometry"/></mxCell>
<mxCell id="c10" value="&lt;b&gt;Hôte Linux + Docker Engine&lt;/b&gt;&lt;br&gt;chaîne complète, deploy inclus" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;dashed=1;" vertex="1" parent="1"><mxGeometry x="1120" y="430" width="320" height="100" as="geometry"/></mxCell>
</root>
</mxGraphModel>
</diagram>
