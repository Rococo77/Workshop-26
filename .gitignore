# Secrets — rien en clair dans l'archive (sujet §7.4)
.env
*.env
!.env.example
*.key
*.pem
secrets.dec.*
# Vault : clé de descellement, jeton racine et jeton de déploiement (local)
.vault/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
.mypy_cache/

# Node / React
node_modules/
dist/
.vite/
*.local

# ML artefacts volumineux (regénérables)
ml/models/*.joblib
ml/data/*.parquet

# Observabilité / données runtime
infra/grafana/data/
infra/prometheus/data/
infra/loki/data/
*.log

# OS / IDE
.DS_Store
.idea/
.vscode/
*.swp

# Photos de visage (donnée biométrique, RGPD art. 9) : jamais versionnées.
services/face-api/*.jpg
services/face-api/*.jpeg
services/face-api/*.png

# Firmware ESP8266 (PlatformIO) : secrets Wi-Fi/jeton réels, jamais versionnés.
firmware/*/include/secrets.h
firmware/*/.pio/

# Fichiers .MD
CLAUDE.md
SUJET.md


# Sauvegardes PRA locales (jamais versionnées)
backups/
